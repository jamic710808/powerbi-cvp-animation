      "id": "s01",
      "title": "月會",
      "visualSeconds": 3.0,
      "leadSeconds": 0.3,
      "tailSeconds": 0.4,
      "externalVoiceVerified": true,
      "narration": "月會上，老闆盯著折線圖：銷售額漲了，利潤卻原地踏步。他問了兩個問題：利潤怎麼沒跟著漲？下個月，至少做多少才不虧？",
      "visual": {
        "subject": {
          "id": "meeting",
          "type": "scene-flat"
        },
        "style": "flat",
        "motion": {
          "action": "gesture",
          "effect": "pop"
